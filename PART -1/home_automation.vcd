$var reg       8 |!   timeout_counter [7:0] $end
$var reg       3 }!   attempt_counter [2:0] $end
$upscope $end


$scope module u_humidity $end
$var wire      1 P    clk  $end
$var wire      1 Q    rst_n  $end
