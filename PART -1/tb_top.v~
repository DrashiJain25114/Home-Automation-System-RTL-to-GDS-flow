`timescale 1ns/1ps

module tb_Top;
    // Testbench signals
    reg clk;
    reg reset;
    
    // Monitor signals
    wire [31:0] PC;
    wire [31:0] instruction;
    wire [31:0] ALU_result;
    wire [31:0] result;
    wire zero;
    wire sign_flag;
    wire [2:0] ALU_control;
    wire reg_write;
    wire mem_write;
    wire pc_src;
    wire [31:0] immidiate_extend;
    wire [31:0] Read_2;
    wire [31:0] Read_data;
    wire [31:0] In_A, In_B;
    
    // Instantiate the Top module
    Top dut (
        .clk(clk),
        .reset(reset)
    );
    
    // Clock generation
    always #5 clk = ~clk;
    
    // Assign internal signals for monitoring
    assign PC = dut.PC;
    assign instruction = dut.instruction;
    assign ALU_result = dut.ALU_result;
    assign result = dut.result;
    assign zero = dut.zero;
    assign sign_flag = dut.sign_flag;
    assign ALU_control = dut.ALU_control;
    assign reg_write = dut.reg_write;
    assign mem_write = dut.mem_write;
    assign pc_src = dut.pc_src;
    assign immidiate_extend = dut.immidiate_extend;
    assign Read_2 = dut.Read_2;
    assign Read_data = dut.Read_data;
    assign In_A = dut.In_A;
    assign In_B = dut.In_B;
    
    // Test program memory content - RISC-V instructions
    reg [31:0] test_instructions [0:31];
    
    // Integer variables for loops (Verilog style)
    integer i;
    integer cycle;
    
    // Initialize test program
    initial begin
        // Initialize instruction memory with test program
        
        // R-type instructions
        test_instructions[0]  = 32'h00500133; // ADD x2, x0, x5
        test_instructions[1]  = 32'h40508233; // SUB x4, x1, x5
        test_instructions[2]  = 32'h0020f2b3; // AND x5, x1, x2
        test_instructions[3]  = 32'h0020e333; // OR  x6, x1, x2
        test_instructions[4]  = 32'h0020c3b3; // XOR x7, x1, x2
        
        // I-type instructions
        test_instructions[5]  = 32'h00408093; // ADDI x1, x1, 4
        test_instructions[6]  = 32'h0010c113; // XORI x2, x1, 1
        test_instructions[7]  = 32'h00109193; // SLLI x3, x1, 1
        test_instructions[8]  = 32'h40115213; // SRAI x4, x2, 1
        
        // Load instructions (I-type)
        test_instructions[9]  = 32'h00002283; // LW   x5, 0(x0)
        test_instructions[10] = 32'h00402303; // LW   x6, 4(x0)
        
        // Store instructions (S-type)
        test_instructions[11] = 32'h00502023; // SW   x5, 0(x0)
        test_instructions[12] = 32'h00602223; // SW   x6, 4(x0)
        
        // Branch instructions (B-type)
        test_instructions[13] = 32'h00208463; // BEQ  x1, x2, 8
        test_instructions[14] = 32'h00209463; // BNE  x1, x2, 8
        test_instructions[15] = 32'h0020c463; // BLT  x1, x2, 8
        
        // More instructions
        test_instructions[16] = 32'hfff08093; // ADDI x1, x1, -1
        test_instructions[17] = 32'h00108113; // ADDI x2, x1, 1
        test_instructions[18] = 32'h00208233; // ADD  x4, x1, x2
        
        // Fill rest with NOPs (ADDI x0, x0, 0)
        for (i = 19; i < 32; i = i + 1) begin
            test_instructions[i] = 32'h00000013; // NOP
        end
    end
    
    // Main test sequence
    initial begin
        $display("=== Starting Top Module Test Bench ===");
        $display("Time\tPC\t\tInstruction\tALU_Result\tRegWrite\tMemWrite\tPCSrc");
        $display("--------------------------------------------------------------------------------");
        
        // Initialize signals
        clk = 0;
        reset = 1;
        
        // Apply reset
        #15 reset = 0;
        #20 reset = 1;
        
        $display("Reset released at time %0t", $time);
        
        // Run simulation for multiple clock cycles
        for (cycle = 0; cycle < 60; cycle = cycle + 1) begin
            #10; // Wait for one clock cycle
            
            if (reset) begin
                display_state(cycle);
            end
            
            // Check for specific conditions
            if (PC >= 32'h00000050) begin
                $display("Reached end of test program at PC = %h, cycle %0d", PC, cycle);
            end
        end
        
        // Perform specific tests
        test_summary;
        
        $display("\n=== Simulation Completed ===");
        #50 $finish;
    end
    
    // Task to display current state
    task display_state;
        input integer cycle_num;
        begin
            $display("%0t\t%h\t%h\t%h\t%b\t\t%b\t\t%b", 
                    $time, PC, instruction, ALU_result, reg_write, mem_write, pc_src);
        end
    endtask
    
    // Test summary and results
    task test_summary;
        begin
            $display("\n=== Test Summary ===");
            $display("Final PC: %h", PC);
            $display("Last Instruction: %h", instruction);
            $display("Last ALU Result: %h", ALU_result);
            $display("Register Write Enabled: %b", reg_write);
            $display("Memory Write Enabled: %b", mem_write);
            $display("Branch Taken: %b", pc_src);
        end
    endtask
    
    // Instruction Memory Model Initialization
    initial begin
        // Wait a bit then initialize instruction memory
        #1;
        
        // Initialize the instruction memory through force statements
        for (i = 0; i < 32; i = i + 1) begin
            force tb_Top.dut.IM.instruction_mem[i] = test_instructions[i];
        end
        
        $display("Instruction memory initialized with test program");
    end
    
    // Data Memory Initialization
    initial begin
        #1;
        // Initialize some data memory locations
        if ($test$plusargs("debug")) begin
            $display("Initializing data memory...");
        end
        
        // Initialize data memory with test values
        force tb_Top.dut.DM.data_mem[0] = 32'h0000000A; // 10
        force tb_Top.dut.DM.data_mem[1] = 32'h00000014; // 20  
        force tb_Top.dut.DM.data_mem[2] = 32'h0000001E; // 30
        force tb_Top.dut.DM.data_mem[3] = 32'h00000028; // 40
        force tb_Top.dut.DM.data_mem[4] = 32'h00000032; // 50
    end
    
    // Register File Initialization
    initial begin
        #1;
        // Initialize some registers with test values
        if ($test$plusargs("debug")) begin
            $display("Initializing register file...");
        end
        
        // Initialize registers (x0 is always zero)
        force tb_Top.dut.RF.reg_file[1] = 32'h00000005;  // x1 = 5
        force tb_Top.dut.RF.reg_file[2] = 32'h0000000A;  // x2 = 10
        force tb_Top.dut.RF.reg_file[3] = 32'h0000000F;  // x3 = 15
        force tb_Top.dut.RF.reg_file[4] = 32'h00000014;  // x4 = 20
        force tb_Top.dut.RF.reg_file[5] = 32'h00000019;  // x5 = 25
        force tb_Top.dut.RF.reg_file[6] = 32'h0000001E;  // x6 = 30
        
        $display("Register file initialized with test values");
    end
    
    // Monitor important signals
    initial begin
        $monitor("Time: %0t | PC: %h | Instr: %h | ALU_Op: %3b | Result: %h | RegWrite: %b | MemWrite: %b", 
                $time, PC, instruction, ALU_control, result, reg_write, mem_write);
    end
    
    // Waveform dumping
    initial begin
        $dumpfile("top_waves.shm");
        $dumpvars(0, tb_Top);
    end
    
    // Automatic verification of control signals
    reg [6:0] current_opcode;
    
    always @(posedge clk) begin
        if (reset) begin
            current_opcode = instruction[6:0];
            
            // Verify instruction decoding after reset is released
            case (current_opcode)
                7'b0110011: begin // R-type
                    if (reg_write !== 1'b1) 
                        $warning("R-type: reg_write should be 1, got %b", reg_write);
                    if (mem_write !== 1'b0) 
                        $warning("R-type: mem_write should be 0, got %b", mem_write);
                end
                7'b0010011: begin // I-type
                    if (reg_write !== 1'b1) 
                        $warning("I-type: reg_write should be 1, got %b", reg_write);
                    if (mem_write !== 1'b0) 
                        $warning("I-type: mem_write should be 0, got %b", mem_write);
                end
                7'b0000011: begin // Load
                    if (reg_write !== 1'b1) 
                        $warning("Load: reg_write should be 1, got %b", reg_write);
                    if (mem_write !== 1'b0) 
                        $warning("Load: mem_write should be 0, got %b", mem_write);
                end
                7'b0100011: begin // Store
                    if (reg_write !== 1'b0) 
                        $warning("Store: reg_write should be 0, got %b", reg_write);
                    if (mem_write !== 1'b1) 
                        $warning("Store: mem_write should be 1, got %b", mem_write);
                end
                7'b1100011: begin // Branch
                    if (reg_write !== 1'b0) 
                        $warning("Branch: reg_write should be 0, got %b", reg_write);
                    if (mem_write !== 1'b0) 
                        $warning("Branch: mem_write should be 0, got %b", mem_write);
                end
            endcase
        end
    end
    
    // Performance monitoring
    integer instruction_count;
    integer branch_taken_count;
    integer memory_access_count;
    
    initial begin
        instruction_count = 0;
        branch_taken_count = 0;
        memory_access_count = 0;
    end
    
    always @(posedge clk) begin
        if (reset) begin
            instruction_count = instruction_count + 1;
            
            if (pc_src) begin
                branch_taken_count = branch_taken_count + 1;
                $display("Branch taken! PC: %h", PC);
            end
            
            if (mem_write) begin
                memory_access_count = memory_access_count + 1;
                $display("Memory write: Address=%h, Data=%h", ALU_result, Read_2);
            end
        end
    end
    
    // Simulation completion and statistics
    initial begin
        #650; // Wait for simulation to complete
        $display("\n=== Simulation Statistics ===");
        $display("Total instructions executed: %0d", instruction_count);
        $display("Branches taken: %0d", branch_taken_count);
        $display("Memory accesses: %0d", memory_access_count);
        $display("Simulation time: %0t ns", $time);
        
        // Final register dump
        $display("\n=== Final Register State ===");
        for (i = 0; i < 8; i = i + 1) begin
            $display("x%0d: %h", i, tb_Top.dut.RF.reg_file[i]);
        end
        
        // Final memory dump
        $display("\n=== Final Memory State ===");
        for (i = 0; i < 5; i = i + 1) begin
            $display("Mem[%0d]: %h", i, tb_Top.dut.DM.data_mem[i]);
        end
    end
    
    // Error checking for unknown states
    always @(posedge clk) begin
        if (reset) begin
            if (instruction === 32'hxxxxxxxx) begin
                $error("Unknown instruction read from memory at PC: %h", PC);
            end
            
            if (ALU_control === 3'bxxx) begin
                $error("Unknown ALU control signal: %b", ALU_control);
            end
        end
    end
    
endmodule
